---
// Páginas legales (política de privacidad): mismo encabezado y pie que la portada, texto en columna.
const { frontmatter } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={frontmatter.description} />
    <title>{frontmatter.title} — MIND</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@200;300;400;500;600&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="nav">
      <a href="/" class="nav-brand">
        <span class="nav-brand-name">MIND</span>
        <span class="nav-brand-tag">Estudio de software</span>
      </a>
      <nav class="nav-links">
        <a href="/#servicios">Servicios</a>
        <a href="/#contacto">Contacto</a>
      </nav>
    </header>

    <main class="legal">
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <span>© {new Date().getFullYear()} MIND LAB E.A.S.</span>
        <a href="/privacidad">Política de privacidad</a>
      </div>
    </footer>

    <style is:global>
      :root {
        --green-trunk: #2d4a3e;
        --green-deep: #1f3a2e;
        --green-leaf: #8ab87a;
        --green-soft: #b8d4a8;
        --paper: #fefefe;
        --ink: #1a2520;
        --ink-soft: #4b5851;
        --line: rgba(45, 74, 62, 0.12);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: "Inter", system-ui, sans-serif;
        font-weight: 300;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .nav {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem clamp(1.5rem, 5vw, 4rem);
        background: rgba(254, 254, 254, 0.85);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--line);
      }

      .nav-brand {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        line-height: 1;
        font-family: "Outfit", sans-serif;
        color: var(--green-deep);
      }

      .nav-brand-name {
        font-weight: 400;
        letter-spacing: 0.35em;
        font-size: 1rem;
      }

      .nav-brand-tag {
        margin-top: 0.35rem;
        font-size: 0.65rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--ink-soft);
      }

      .nav-links {
        display: flex;
        gap: 2rem;
        font-size: 0.9rem;
        letter-spacing: 0.04em;
      }

      .nav-links a {
        color: var(--ink-soft);
      }

      .nav-links a:hover {
        color: var(--green-trunk);
      }

      @media (max-width: 640px) {
        .nav-links {
          display: none;
        }
      }

      .legal {
        max-width: 720px;
        margin: 0 auto;
        padding: clamp(3rem, 8vh, 5rem) clamp(1.5rem, 5vw, 2rem);
      }

      .legal h1,
      .legal h2 {
        font-family: "Outfit", system-ui, sans-serif;
        font-weight: 300;
        letter-spacing: -0.01em;
        color: var(--green-deep);
      }

      .legal h1 {
        font-size: clamp(2rem, 5vw, 2.75rem);
        line-height: 1.15;
        margin: 0 0 0.5rem;
      }

      .legal h2 {
        font-size: 1.4rem;
        margin: 2.5rem 0 0.75rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--line);
        scroll-margin-top: 6rem;
      }

      .legal strong {
        font-weight: 500;
      }

      .legal a {
        color: var(--green-trunk);
        border-bottom: 1px solid var(--green-soft);
      }

      .legal ul,
      .legal ol {
        padding-left: 1.25rem;
      }

      .legal li {
        margin-bottom: 0.35rem;
      }

      footer {
        border-top: 1px solid var(--line);
        margin-top: 4rem;
      }

      .footer-inner {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem clamp(1.5rem, 5vw, 4rem);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.85rem;
        color: var(--ink-soft);
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .footer-inner a:hover {
        color: var(--green-trunk);
      }
    </style>
  </body>
</html>
